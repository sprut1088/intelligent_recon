# Prototype uses SQLite by default.
# For production, replace with PostgreSQL configuration.
ENVIRONMENT=local

# Required for Tier 2c LLM adjudication and (optionally) Tier 2b embeddings.
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Embedding provider for Tier 2b AI triage.
# "local"      — SentenceTransformer all-MiniLM-L6-v2 (no key needed, slow on first run
#                as it downloads the model ~90 MB).
# "openrouter" — OpenRouter batch API (requires OPENROUTER_API_KEY, no download needed).
EMBEDDING_PROVIDER=local

# OpenRouter embedding model. Only used when EMBEDDING_PROVIDER=openrouter.
# EMBEDDING_MODEL_OPENROUTER=google/gemini-embedding-2-preview
